# --- Flask ---
FLASK_ENV=development
SECRET_KEY=change-me-in-local-env
JWT_SECRET_KEY=change-me-too
JWT_ACCESS_MINUTES=30
JWT_REFRESH_DAYS=30

# --- Database (SQLite only, relative to backend/) ---
DATABASE_URL=sqlite:///instance/carbonwise.sqlite3

# --- Server ---
HOST=127.0.0.1
PORT=5000
DEFAULT_LANGUAGE=ar
CURRENCY=N/A

# --- OpenRouter (backend only; leave empty to disable AI) ---
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openrouter/free
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
AI_DAILY_TOKEN_BUDGET=200000
AI_RATE_LIMIT_PER_HOUR=20
AI_CACHE_TTL_MINUTES=60
AI_MAX_RETRIES=2
AI_REQUEST_TIMEOUT_SECONDS=45
AI_COMPLETION_TOKEN_FLOOR=4096
AI_REASONING_TOKEN_CAP=1024
AI_SCREENSHOT_MODE=0

# --- Uploads (private, git-ignored) ---
UPLOAD_FOLDER=instance/uploads
MAX_CONTENT_LENGTH=31457280
MAX_IMAGE_BYTES=10485760
ALLOWED_IMAGE_TYPES=image/jpeg,image/png,image/webp
ALLOWED_DOCUMENT_TYPES=application/pdf

# --- Seed (demo only; never real secrets) ---
ADMIN_SEED_EMAIL=admin@carbonwise.demo
ADMIN_SEED_PASSWORD=
DEMO_SEED_DATE=2026-06-30

# --- Notifications ---
SIGNIFICANT_INCREASE_PERCENT=20
SIGNIFICANT_INCREASE_MIN_KG=10
